        function handleGeolocation(mapInstance: L.Map): void {
            if (mapViewFromUrl) {
                const center = mapInstance.getCenter();
                fetchTemperature(center.lat, center.lng);
                return;
            }
            if (navigator.geolocation) {
                navigator.geolocation.getCurrentPosition(
                    (position) => {
                        const { latitude, longitude } = position.coords;
                        const userCoords: L.LatLngTuple = [latitude, longitude];
                        mapInstance.setView(userCoords, USER_LOCATION_ZOOM);
                        const userIcon = L.icon({
                            iconUrl: USER_ICON_URL,
                            iconSize: [50, 50],
                            iconAnchor: [19, 38],
                            popupAnchor: [0, -38],
                        });
                        L.marker(userCoords, { icon: userIcon }).addTo(
                            mapInstance,
                        );
                        fetchTemperature(latitude, longitude);
                    },
                    (error) => {
                        console.error("Error getting location:", error.message);
                        console.warn("Using default location for temperature.");
                        fetchTemperature(
                            MEDELLIN_COORDS[0],
                            MEDELLIN_COORDS[1],
                        );
                    },
                    {
                        enableHighAccuracy: false,
                        timeout: 10000,
                        maximumAge: 60000,
                    },
                );
            } else {
                console.warn("Geolocation is not supported.");
                fetchTemperature(MEDELLIN_COORDS[0], MEDELLIN_COORDS[1]);
            }
        }

        /**
         * Starts the periodic refresh of the radar data.
         * If animated, fetches new frames. If static, refetches and shows the latest frame.
         * @param {L.Map} mapInstance - The Leaflet map instance.
         */
        function startRadarRefresh(mapInstance: L.Map): void {
            if (radarUpdateInterval !== null) {
                clearInterval(radarUpdateInterval);
            }
            radarUpdateInterval = window.setInterval(() => {
                console.log("Periodic radar refresh triggered.");
                if (isRadarAnimated) {
                    // If animating, fetch new frames and restart animation
                    console.log("Refreshing animation frames...");
                    startRadarAnimation(mapInstance); // This will stop old animation and fetch new data
                } else {
                    console.log("Refreshing static radar image...");
                    void showStaticRadar(mapInstance, { refetch: true });
                }
            }, RADAR_REFRESH_INTERVAL_MS);
        }

        // --- Main Execution ---
        try {
            map = initializeMap();
            const baseLayers = getBaseLayers();
            setupThemeSwitcher(map, baseLayers);
            applyMapViewFromUrl(map);
            map.invalidateSize();

            const modeFromUrl = getInitialModeFromUrl();
            isRadarAnimated =
                modeFromUrl ?? getInitialToggleState();
            updateRadarModeButton(isRadarAnimated);

            if (isRadarAnimated) {
                // Start with animation if toggle is checked
                startRadarAnimation(map);
            } else {
                void showStaticRadar(map, { refetch: false });
            }

            // Add custom small pin marker with person image at specific coordinates

            // const personPinCoords: L.LatLngTuple = [6.315236, -76.134347]; // Example: Laureles, Medellín
            const personPinCoords: L.LatLngTuple = [6.257279, -76.114007]; // Updated coordinates
              
            // Function to calculate icon size based on zoom level
            function getIconSize(zoom: number): [number, number] {
                // Base width at zoom level 10
                const baseWidth = 26;
                const baseZoom = 10;
                
                // Calculate size multiplier based on zoom difference
                const zoomDiff = zoom - baseZoom;
                const sizeMultiplier = Math.pow(1.2, zoomDiff); // 1.2x per zoom level
                
                const width = Math.max(12, Math.min(80, baseWidth * sizeMultiplier)); // Min 12px, Max 80px
                const height = width * 1.5; // Double height for non-square image
                return [width, height];
            }
            
            // Function to calculate anchor based on icon size
            function getIconAnchor(size: number): [number, number] {
                return [size / 2, size];
            }
            
            // Function to calculate popup anchor based on icon size
            function getPopupAnchor(size: number): [number, number] {
                return [0, -size];
            }
            
            // Create initial icon
            let personPinIcon = L.icon({
                iconUrl: "/solidos.png",
                iconSize: getIconSize(map!.getZoom()),
                iconAnchor: getIconAnchor(getIconSize(map!.getZoom())[0]),
                popupAnchor: getPopupAnchor(getIconSize(map!.getZoom())[0]),
            });
            
            // Create marker (initially hidden)
            const personMarker = L.marker(personPinCoords, { icon: personPinIcon });
            
            // Function to show/hide marker based on zoom level
            function updateMarkerVisibility(zoom: number) {
                const minZoomToShow = 12; // Only show when zoomed in to level 12 or higher
                
                if (zoom >= minZoomToShow) {
                    if (!map!.hasLayer(personMarker)) {
                        personMarker.addTo(map!);
                    }
                    // Update icon size when visible
                    const newSize = getIconSize(zoom);
                    const newIcon = L.icon({
                        iconUrl: "/solidos.png",
                        iconSize: newSize,
                        iconAnchor: getIconAnchor(newSize[0]),
                        popupAnchor: getPopupAnchor(newSize[0]),
                    });
                    personMarker.setIcon(newIcon);
                } else {
                    if (map!.hasLayer(personMarker)) {
                        personMarker.removeFrom(map!);
                    }
                }
            }
            
            // Update marker visibility and size on zoom change
            map!.on('zoomend', () => {
                updateMarkerVisibility(map!.getZoom());
            });
            
            // Set initial visibility
            updateMarkerVisibility(map!.getZoom());

            setupEventListeners(map);
            handleGeolocation(map);
            startRadarRefresh(map);
        } catch (error) {
            console.error("Failed to initialize map component:", error);
            if (mapElement) {
                mapElement.innerHTML =
                    '<p style="padding: 20px; text-align: center; color: red;">Error loading map.</p>';
            }
            updateTemperatureUI(null, null, false, true);
        }
    }); // End of DOMContentLoaded listener
</script>
